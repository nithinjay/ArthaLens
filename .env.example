# ArthaLens local environment — PLACEHOLDERS ONLY.
# Copy to .env (gitignored):  pnpm env:init   (generates random local secrets)
# Never commit .env. Never paste real keys into source files.

# --- PostgreSQL (docker compose) ---
# Superuser: used ONLY by the init script that creates the roles below.
POSTGRES_PASSWORD=change-me
# Owns the schema; used only by migrations (dbmate).
APP_MIGRATE_DB_PASSWORD=change-me
# Runtime role for backend/ (no DDL, no BYPASSRLS).
APP_API_DB_PASSWORD=change-me
# Runtime role for ai/ (no DDL, no BYPASSRLS).
APP_AI_DB_PASSWORD=change-me
# Host port for Postgres (127.0.0.1 only). 5433 avoids clashing with a local Postgres on 5432.
POSTGRES_HOST_PORT=5433

# --- Service-to-service auth (backend -> ai internal API) ---
# At least 32 characters. Generate: openssl rand -hex 32
AI_SERVICE_TOKEN=change-me-to-a-random-value-of-at-least-32-chars

# --- Gemini (used from Milestone 4; leave empty until then) ---
GEMINI_API_KEY=

# --- Source providers ---
# Live fetching of individual public SEBI documents (off by default; see ADR-0015).
PROVIDER_SEBI_FETCH_ENABLED=false

# --- Runtime ---
LOG_LEVEL=info
