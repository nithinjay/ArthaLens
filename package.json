{
  "name": "arthalens",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "dev:backend": "pnpm --filter @arthalens/contracts build && pnpm --filter @arthalens/backend dev",
    "dev:frontend": "pnpm --filter @arthalens/frontend dev",
    "contracts:gen": "uv run --project ai python -m arthalens_ai.contracts.export packages/contracts/schemas && node packages/contracts/scripts/generate.mjs",
    "contracts:check": "pnpm contracts:gen && git diff --exit-code -- packages/contracts/schemas packages/contracts/src/generated",
    "secrets:scan": "sh scripts/secrets-scan.sh",
    "env:init": "sh scripts/dev-env.sh",
    "smoke": "sh scripts/smoke.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
